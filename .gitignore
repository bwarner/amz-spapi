.claude
# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

vite.config.*.timestamp*

.swp

vitest.config.*.timestamp*

# Next.js
.next
out

# AWS CDK
cdk.out

.claude/settings.local.json

# Or more broadly exclude all local Claude settings
.claude/*.local.json

config.toml

# SSL certificates (local dev)
apps/web/certificates/*.pem

# TypeScript build info
*.tsbuildinfo
.vercel

.nx/polygraph
.claude/worktrees

# Agent / editor tool working dirs
.codex/
.cursor/
.agents/

# Local scratch screenshots
sellavant-home-smoke.png

# A+ design-preview renders (dev harness output)
tools/render-out/

# OpenCode agent config — a byte-identical copy of .github/skills that Nx
# regenerates for a second agent tool. One copy in the repo is enough; two
# would drift.
.opencode/
opencode.json

# A local pnpm store, if one is configured inside the repo. Large, machine
# specific, and reconstructible.
.pnpm-store/

# This workspace is pnpm (see `packageManager` and pnpm-lock.yaml). An npm
# lockfile here means `npm install` was run, and the flat node_modules it
# produces HIDES undeclared workspace dependencies — a package that forgot to
# declare an internal dep resolves fine locally and fails in CI, which is the
# exact failure the pnpm migration was undertaken to surface. Ignored so it
# cannot be committed and cannot change which package manager a tool picks.
package-lock.json
