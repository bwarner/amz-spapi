{
  "mcpServers": {
    "auth0": {
      "command": "npx",
      "args": ["@auth0/auth0-mcp-server", "run"],
      "env": {
        "AUTH0_DOMAIN": "sellavant-dev.us.auth0.com"
      }
    },
    "couchbase": {
      "command": "sh",
      "args": [
        "-c",
        "set -a && . ./apps/web/.env.local && set +a && CB_CONNECTION_STRING=\"$CB_CONNECT_STRING\" exec uvx couchbase-mcp-server"
      ],
      "env": {
        "CB_MCP_READ_ONLY_MODE": "true"
      }
    },
    "playwright": {
      "command": "/Users/bwarner/.volta/bin/npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {
        "VOLTA_HOME": "/Users/bwarner/.volta",
        "PATH": "/Users/bwarner/.volta/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
