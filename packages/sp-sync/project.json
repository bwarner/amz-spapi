{
  "name": "sp-sync",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/sp-sync/src",
  "projectType": "library",
  "tags": ["scope:data", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/sp-sync",
        "main": "packages/sp-sync/src/index.ts",
        "tsConfig": "packages/sp-sync/tsconfig.lib.json",
        "assets": ["packages/sp-sync/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/packages/sp-sync"
      }
    }
  }
}
