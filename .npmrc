# pnpm is the package manager — see "packageManager" in package.json.
#
# pnpm's own settings live in pnpm-workspace.yaml (nodeLinker, autoInstallPeers,
# strictPeerDependencies, onlyBuiltDependencies, overrides), not here. Only
# settings pnpm actually reads from .npmrc belong in this file.
#
# What used to be here, and why it is gone:
#   package-manager=npm    not an npm or a pnpm setting. It contradicted
#                          packageManager and made npm warn on every command
#   enable-yarn=false      likewise not a real setting
#   legacy-peer-deps=true  npm-only; the pnpm equivalents are
#                          strictPeerDependencies and autoInstallPeers, already
#                          set in pnpm-workspace.yaml
#   audit=false fund=false npm-only, inert under pnpm

# Pin the public registry, so that a developer's global config — a local
# Verdaccio, for instance — cannot quietly become the source of workspace
# dependencies.
registry=https://registry.npmjs.org/
