{
  "name": "lambda-credentials",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/lambdas/credentials/src",
  "projectType": "application",
  "tags": ["scope:lambda", "type:app"],
  "metadata": {
    "lambda": {
      "packaging": "zip",
      "handler": "main.handler",
      "description": "Seller credential profiles, and the short-lived access tokens minted from them. No refresh token or client secret leaves this function.",
      "timeoutSeconds": 30,
      "memoryMb": 256,
      "routes": [
        "GET /credentials",
        "GET /credentials/{apiType}/{profileName}",
        "DELETE /credentials/{apiType}/{profileName}",
        "POST /credentials/connect",
        "POST /credentials/{apiType}/{profileName}/access-token",
        "POST /credentials/service/access-token"
      ],
      "couchbase": true,
      "amazonCredentials": true
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/lambdas/credentials",
        "main": "apps/lambdas/credentials/src/main.ts",
        "tsConfig": "apps/lambdas/credentials/tsconfig.app.json",
        "platform": "node",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "minify": false,
        "sourcemap": true,
        "generatePackageJson": false,
        "esbuildOptions": {
          "outExtension": {
            ".js": ".js"
          },
          "banner": {
            "js": "import { createRequire as __nodeCreateRequire } from 'node:module';const require = __nodeCreateRequire(import.meta.url);"
          }
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../coverage/apps/lambdas/credentials"
      }
    }
  }
}
