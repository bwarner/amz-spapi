{
  "name": "aws-secrets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/aws-secrets/src",
  "projectType": "library",
  "tags": ["scope:data", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/aws-secrets",
        "main": "libs/aws-secrets/src/index.ts",
        "tsConfig": "libs/aws-secrets/tsconfig.lib.json",
        "assets": ["libs/aws-secrets/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/libs/aws-secrets"
      }
    }
  }
}
