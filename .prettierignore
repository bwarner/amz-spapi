# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data

# Generated API types. These files are written by openapi-typescript, and
# formatting them makes the checked-in copy differ from what the generator
# emits — so the next `generate` run produces a tens-of-thousands-of-line diff
# that has nothing to do with the change being made. The generator owns the
# formatting; leave it alone.
/packages/amazon-ads-generated/src/lib
/packages/amazon-sp-generated/src/lib

# The pnpm lockfile. pnpm rewrites it in its own canonical style on every
# install, so formatting it here means the two fight: prettier wraps
# `resolution: { integrity: … }` across three lines, the next `pnpm install`
# unwraps every one of them, and a one-line dependency change arrives as a
# 15,000-line diff nobody can review. Same reasoning as the generated types
# above — the tool owns the formatting.
/pnpm-lock.yaml
